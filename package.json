{
  "name": "dsh-paper-harness",
  "version": "0.1.0",
  "description": "文献台 — DeepSeek Harness 的文献阅读工作台：拖入 PDF 即索引，原文可选即问，按页区间翻译，按分类/标签整理。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "baigaobai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baigaobai/dsh-paper-harness.git"
  },
  "homepage": "https://github.com/baigaobai/dsh-paper-harness#readme",
  "bugs": {
    "url": "https://github.com/baigaobai/dsh-paper-harness/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "paper",
    "literature",
    "pdf",
    "reading",
    "translation",
    "research"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "pdfjs-dist": "4.10.38"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-win32-x64-msvc": "1.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
